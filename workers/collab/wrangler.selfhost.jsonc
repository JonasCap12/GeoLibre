{
  // Self-hosting config for the live-collaboration Worker.
  //
  // WHY THIS FILE EXISTS, instead of editing wrangler.toml beside it:
  // wrangler.toml binds the custom domain collab.geolibre.app, which only the
  // upstream project's Cloudflare account can provision — a deploy from any
  // other account fails on it. wrangler.toml is also an upstream-tracked file,
  // and this fork fast-forwards from upstream, so editing it would put a
  // conflict in the path of every future sync. A second config, passed with
  // `wrangler deploy -c`, keeps that path clean.
  //
  // Deploy with:
  //   npx wrangler deploy -c workers/collab/wrangler.selfhost.jsonc
  //
  // KEEP IN SYNC with wrangler.toml. The Durable Object binding name, the class
  // name and the migration tag are part of the deployed state: renaming a class
  // or skipping a migration tag orphans existing session objects. Everything
  // below except "routes" is copied from there verbatim, and a drift check runs
  // in tests/collab-selfhost-config.test.ts.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "geolibre-collab",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",

  // No "routes": this deploys to geolibre-collab.<subdomain>.workers.dev.
  // Point VITE_GEOLIBRE_COLLAB_URL at that address. To use a custom domain
  // later, add the block wrangler.toml has, with a zone this account manages:
  //
  //   "routes": [{ "pattern": "collab.example.com", "custom_domain": true }]

  // Each live session is one Durable Object instance (addressed by its session
  // code via idFromName), so all participants' sockets land on the same actor
  // and can be fanned out to.
  "durable_objects": {
    "bindings": [{ "name": "COLLAB_SESSION", "class_name": "CollabSession" }]
  },

  // SQLite-backed Durable Object: cheaper, and required for the WebSocket
  // Hibernation API used to keep idle sessions' sockets open without holding
  // the actor in memory.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollabSession"] }],

  // Who may create a session. Without this the Worker falls back to the
  // upstream list in src/index.ts -- *.geolibre.app, localhost and tauri: --
  // which does not include this deployment, so every attempt to start a
  // session was refused with "Origin not allowed to create sessions." The
  // Worker was live and configured and the feature still did nothing.
  //
  // Set to this deployment's own app origin, not a wildcard: the tiles Worker
  // admits any *.workers.dev, and that is exactly what would let a stranger's
  // page open sessions on this account. Add each additional origin that should
  // be able to start a session, comma-separated, including a custom domain
  // when one is bound.
  "vars": {
    "ALLOWED_ORIGINS": "https://gis.jonasnguyen.uk,https://geolibre-web.jonasnguyen886.workers.dev",
    // Members only: creating or joining a session needs an identity token
    // from the projects API (POST /api/collab/identity), signed with
    // COLLAB_IDENTITY_SECRET. Set that secret on BOTH Workers, same value:
    //   wrangler secret put COLLAB_IDENTITY_SECRET -c workers/collab/wrangler.selfhost.jsonc
    //   wrangler secret put COLLAB_IDENTITY_SECRET -c workers/projects-api/wrangler.jsonc
    // Without it this relay refuses everyone, which is the safe failure.
    "COLLAB_REQUIRE_IDENTITY": "1"
  }

  // COLLAB_IDENTITY_SECRET is a secret, never a var, so it does not land in
  // this file. It used to be left unset, which made every session open to
  // anyone holding its 8-character code; now that the team has accounts the
  // relay is members-only (COLLAB_REQUIRE_IDENTITY above) and needs it.
}
