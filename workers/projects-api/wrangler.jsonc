{
  // GeoLibre projects and identity API on Workers.
  //
  // A port of backend/geolibre_server_api (FastAPI + SQLAlchemy + boto3) to the
  // Workers runtime: D1 replaces the SQL database and R2 replaces filesystem/S3
  // object storage. The HTTP contract is docs/server-api.md, which is
  // implementation-independent by design ("A compatible server may use any
  // implementation or storage engine"); that document, not the Python module, is
  // the authority for behaviour.
  //
  // Object keys are unchanged from the Python implementation
  // (projects/<id>/versions/<n>.json, projects/<id>/thumbnail), so an existing
  // S3 bucket can be copied into R2 as-is. Password hashes are unchanged too
  // (scrypt, same parameters and same `scrypt$salt$digest` encoding), so an
  // imported accounts table keeps working and nobody has to reset a password.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "geolibre-projects-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geolibre-projects",
      "database_id": "da951668-c6b3-47f3-bde0-a88bfec4b516"
    }
  ],

  "send_email": [
    {
      "name": "EMAIL",
      // Restrict the sender so a bug in this Worker cannot turn it into an open
      // relay. The operator sets the address; it must match GEOLIBRE_EMAIL_FROM.
      "allowed_sender_addresses": ["noreply@geolibre.jonasnguyen.uk"]
    }
  ],

  "r2_buckets": [
    {
      "binding": "OBJECTS",
      // Replace with the name used by `wrangler r2 bucket create …`.
      "bucket_name": "geolibre-projects"
    }
  ],

  "vars": {
    // Externally reachable origin of THIS API. It is what rawJsonUrl and
    // projectUrl are built from, so a wrong value ships broken links in every
    // project response.
    "GEOLIBRE_PUBLIC_URL": "https://geolibre-projects-api.jonasnguyen886.workers.dev",
    // Where GET /{username}/{slug} redirects, and the base of viewerUrl and of
    // every link in account mail (invite, reset, email confirmation). The
    // workers/web deployment's custom domain, which is where the team signs
    // in: the session lives in that origin's storage, so a link to the
    // workers.dev hostname would leave someone signed in on the wrong origin.
    "GEOLIBRE_VIEWER_URL": "https://gis.jonasnguyen.uk",
    // Comma-separated browser origins allowed to call this API. Unlike the
    // Python default of "*", this has no wildcard default: the app and the API
    // are on different hostnames here, so an operator has to name the app
    // origin anyway, and a deployment that forgets should fail visibly in the
    // browser rather than quietly accept every origin on the internet.
    //
    // Both hostnames of workers/web: the custom domain the team uses, and the
    // workers.dev one, which still serves the same app. This list also decides
    // which hostnames a Turnstile token may come from (src/turnstile.ts), so
    // the Turnstile widget must list the same two.
    "GEOLIBRE_CORS_ORIGINS": "https://gis.jonasnguyen.uk,https://geolibre-web.jonasnguyen886.workers.dev",
    // Comma-separated admin usernames. Empty or omitted means nobody can mint
    // invites — an unconfigured deployment must not be seedable by a stranger.
    // Keep it naming only accounts that exist: an unregistered name here could
    // be claimed by whoever is invited next and picks it.
    "GEOLIBRE_ADMIN_USERNAMES": "nhut",
    // Must match an entry in send_email.allowed_sender_addresses above, and the
    // domain must be onboarded to Cloudflare Email Sending on this account —
    // sending from a domain you do not control is refused, not merely spam-
    // filtered. The sending domain is the geolibre. subdomain, not the apex:
    // that is what is onboarded (`wrangler email sending list` shows it, with
    // its SPF, DKIM and DMARC records), and the apex has no sending setup, so
    // mail from noreply@jonasnguyen.uk would not be delivered.
    "GEOLIBRE_EMAIL_FROM": "noreply@geolibre.jonasnguyen.uk",
    "GEOLIBRE_MAX_PROJECT_BYTES": "52428800",
    "GEOLIBRE_MAX_THUMBNAIL_BYTES": "5242880",
    // Also the retention of the auth audit log (auth_events).
    "GEOLIBRE_ACTIVITY_RETENTION_DAYS": "90",
    // A bearer dies this many days after sign-in whatever happens (absolute),
    // or after this many days without a request (idle), whichever is first.
    // A leaked token used to be valid until someone revoked it by hand.
    "GEOLIBRE_SESSION_TTL_DAYS": "30",
    "GEOLIBRE_SESSION_IDLE_DAYS": "7",
    // Days a deleted dataset or project stays in the R2 trash before the daily
    // cron below purges it (src/storage.ts). Matches D1 Time Travel's window,
    // so a deletion can be undone end to end.
    "GEOLIBRE_TRASH_RETENTION_DAYS": "30",
    // Two-factor authentication is required of every account. An account
    // without it has GEOLIBRE_MFA_GRACE_DAYS from this date, or from its own
    // creation if later, to turn it on; after that it can only reach the
    // routes needed to do so (see mfaEnrollmentRequired in auth-policy.ts).
    // Remove the date to stop requiring it.
    "GEOLIBRE_MFA_REQUIRED_FROM": "2026-10-04",
    "GEOLIBRE_MFA_GRACE_DAYS": "7"
    // Secrets, set with `wrangler secret put … -c workers/projects-api/wrangler.jsonc`
    // and never written here:
    //   TURNSTILE_SECRET_KEY  bot check on register / reset. Unset skips it
    //                         with a warning in the logs.
    //   MFA_ENCRYPTION_KEY    base64 of 32 random bytes; encrypts TOTP secrets.
  },

  // docs/server-api.md lists rate limiting as something "the reference server
  // leaves to the operator", and names the two routes that need it: both are
  // unauthenticated and both run scrypt on every call, so without a limiter they
  // allow password brute-forcing, username enumeration through the 409/401
  // distinction, and a cheap CPU burn. Unlike the Python deployment, which needs
  // a reverse proxy or WAF for this, the platform offers it directly — so it is
  // configured here and enforced in src/index.ts.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      // Unlike D1/R2, a rate-limit namespace id is not a resource you create in
      // advance — it is an arbitrary string you pick yourself to scope the
      // binding, the same way workers/ai-proxy picked "54701". Any value works
      // as long as it doesn't collide with another ratelimits binding in this
      // account; there is no `wrangler` command that allocates or registers one.
      "namespace_id": "54702",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      // Dataset downloads. Unlike the two routes above this one is cheap in CPU
      // and expensive in everything else: each call streams up to
      // GEOLIBRE_MAX_DATASET_BYTES out of R2 (billed egress) and writes one D1
      // row to count the download. A public dataset needs no credentials, so an
      // id and a loop is all it takes to run up a bill on someone else's
      // account -- the cheapest amplification surface this API has.
      //
      // 60/minute, not 10: a download is a legitimate bulk action and a team
      // pulling a project's files should never see this, whereas a script
      // looping on one id will. Egress is bounded by that times the size cap.
      "name": "DOWNLOAD_RATE_LIMITER",
      "namespace_id": "54703",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      // Sign-in attempts per identifier (username or email as typed), on top of
      // the per-IP limit above. The IP limit alone lets a botnet spread guesses
      // for one person across thousands of addresses. Throttling, not lockout:
      // a lockout would let anyone who knows a username keep its owner out.
      // 5/minute is far above what a person mistyping produces.
      "name": "AUTH_ACCOUNT_RATE_LIMITER",
      "namespace_id": "54704",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],

  // scrypt at n=2^14, r=8 measured in workerd (wrangler dev, scrypt-js) at
  // ~67 ms per call with p=1 and ~333 ms with p=5, the parameter new hashes use
  // (see src/auth.ts). A sign-in that upgrades a legacy p=1 hash pays both,
  // ~400 ms. The 10 ms free-tier ceiling cannot fit any of that, so this Worker
  // requires a paid plan, as workers/tiles does for its reprojection path.
  //
  // 2000 rather than the previous 1000 because Cloudflare's edge CPUs are not
  // the laptop the numbers above came from, and exceeding the limit fails the
  // request outright (error 1102) instead of slowing it. The limit is a
  // ceiling, not a cost: billing is by CPU actually used.
  // Daily at 03:23 UTC: purge the R2 trash (the `scheduled` handler).
  "triggers": {
    "crons": ["23 3 * * *"]
  },

  "limits": {
    "cpu_ms": 2000
  },

  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }

  // No "routes": deploys to geolibre-projects-api.<subdomain>.workers.dev. Bind a
  // custom domain the way workers/tiles and workers/collab do, and set
  // GEOLIBRE_PUBLIC_URL above to the same hostname:
  //
  //   "routes": [{ "pattern": "projects.example.com", "custom_domain": true }]
}
